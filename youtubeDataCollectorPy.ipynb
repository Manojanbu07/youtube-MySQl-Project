# ─────────────────────────────────────────────
#  CONFIG
# ─────────────────────────────────────────────
API_KEY = os.getenv("YOUTUBE_API_KEY")
 CHANNEL_IDS = [
    "UCVhQ2NnY5Rskt6UjCUkJ_DA",   # your channel
    "UCCTVrRjhBkJiHST_5eVvJ2A",   # Krish Naik
    "UCWN3xxRkmTPmbKwht9FuE5A",   # Siraj Raval
    "UC7cs8q-gJRlGwj4A8OmCmXg",   # Alex The Analyst
